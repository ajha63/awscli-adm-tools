# ─────────────────────────────────────────────────────────────
# Entorno de administración AWS — variables de configuración
# Copia este archivo a .env y ajusta los valores.
# NUNCA commits .env — solo .env.example va al repositorio.
# ─────────────────────────────────────────────────────────────

# Perfil AWS CLI a usar (IAM Identity Center / SSO recomendado)
AWS_PROFILE=alhernan

# Región por defecto
AWS_DEFAULT_REGION=us-east-1

# ID de cuenta esperada — usada para validar identidad antes de operar
EXPECTED_ACCOUNT_ID=554982632606

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Opcional: sobrescritura puntual (NO usar en producción) ───
# Solo si necesitas credenciales temporales explícitas (ej. CI/CD sin SSO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
